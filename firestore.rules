rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Esnaflar: sadece kendi belgesini okuyabilir, yazmak yasak (Admin SDK yazar)
    match /esnaflar/{esnafId} {
      allow read: if request.auth != null && request.auth.uid == esnafId;
      allow write: if false;
    }

    // Yorumlar: giriş yapmış kullanıcı okuyabilir
    match /yorumlar/{yorumId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // İçerikler: giriş yapmış kullanıcı okuyabilir
    match /icerikler/{icerikId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Agent logları: sadece backend okuyabilir (Admin SDK bypass eder)
    match /agent_logs/{logId} {
      allow read: if false;
      allow write: if false;
    }

    // Kota kullanım: sadece backend
    match /kota_kullanim/{kotaId} {
      allow read: if false;
      allow write: if false;
    }

    // Karaliste: sadece backend
    match /karaliste/{listeId} {
      allow read: if false;
      allow write: if false;
    }

    // Leadler: sadece backend
    match /leads/{leadId} {
      allow read: if false;
      allow write: if false;
    }

    // Hatalar: sadece backend
    match /hatalar/{hataId} {
      allow read: if false;
      allow write: if false;
    }

    // Varsayılan: her şeyi reddet
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
