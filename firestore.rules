/**
 * Firestore Security Rules — kepenk.ai
 *
 * Multi-tenant RBAC with role-based access control.
 * Roles: owner > admin > editor > viewer
 */
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══ HELPER FUNCTIONS ═══

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole(siteId) {
      return request.auth.token.sites[siteId];
    }

    function hasRole(siteId, role) {
      return isSignedIn() && getUserRole(siteId) == role;
    }

    function hasAnyRole(siteId, roles) {
      return isSignedIn() && getUserRole(siteId) in roles;
    }

    function isOwnerOrAdmin(siteId) {
      return hasAnyRole(siteId, ['owner', 'admin']);
    }

    function canRead(siteId) {
      return hasAnyRole(siteId, ['owner', 'admin', 'editor', 'viewer']);
    }

    function canWrite(siteId) {
      return hasAnyRole(siteId, ['owner', 'admin', 'editor']);
    }

    function canDelete(siteId) {
      return isOwnerOrAdmin(siteId);
    }

    // ═══ SITES ═══

    match /sites/{siteId} {
      allow read: if canRead(siteId);
      allow update: if isOwnerOrAdmin(siteId);
      allow delete: if hasRole(siteId, 'owner');

      // Products
      match /products/{productId} {
        allow read: if canRead(siteId);
        allow create, update: if canWrite(siteId);
        allow delete: if canDelete(siteId);
      }

      // Orders
      match /orders/{orderId} {
        allow read: if canRead(siteId);
        allow create: if canWrite(siteId);
        allow update: if canWrite(siteId);
      }

      // Members
      match /members/{memberId} {
        allow read: if canRead(siteId);
        allow create: if isOwnerOrAdmin(siteId);
        allow update: if isOwnerOrAdmin(siteId);
        allow delete: if canDelete(siteId);
      }

      // Transactions (accounting)
      match /transactions/{txId} {
        allow read: if canRead(siteId);
        allow create: if canWrite(siteId);
        allow update: if isOwnerOrAdmin(siteId);
      }

      // Bookings
      match /bookings/{bookingId} {
        allow read: if canRead(siteId);
        allow create, update: if canWrite(siteId);
        allow delete: if canDelete(siteId);
      }

      // Customer conversations (WhatsApp)
      match /conversations/{convId} {
        allow read: if canRead(siteId);
        allow write: if canWrite(siteId);

        match /messages/{msgId} {
          allow read: if canRead(siteId);
          allow create: if canWrite(siteId);
        }
      }

      // AI Usage tracking
      match /aiUsage/{period} {
        allow read: if isOwnerOrAdmin(siteId);
        allow write: if false; // Only server writes
      }

      // Counters (distributed)
      match /counters/{counterId} {
        allow read: if canRead(siteId);
        allow write: if false; // Only server writes
      }
    }

    // ═══ PLATFORM (admin only) ═══

    match /platform/{document=**} {
      allow read: if request.auth.token.admin == true;
      allow write: if false; // Only server writes
    }

    // ═══ PUBLIC (QR menu, public site) ═══

    match /public/{siteId}/menu/{menuId} {
      allow read: if true; // Public menu for QR ordering
      allow write: if false;
    }

    // ═══ DEFAULT DENY ═══

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
